parameters:
	ignoreErrors:
		-
			message: '#^Variable \$errstr on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: src/Logger/OtelLoggerFactory.php

		-
			message: '#^Constant LARAVEL_START not found\.$#'
			identifier: constant.notFound
			count: 1
			path: src/Middleware/OpenTelemetryTraceMiddleware.php

		-
			message: '#^Static property Laratel\\Opentelemetry\\Services\\MetricsService\:\:\$previousCpu is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Services/MetricsService.php

		-
			message: '#^Static property Laratel\\Opentelemetry\\Services\\MetricsService\:\:\$previousNetwork is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Services/MetricsService.php

		-
			message: '#^Constant LARAVEL_START not found\.$#'
			identifier: constant.notFound
			count: 1
			path: src/Services/TraceService.php

		-
			message: '#^Parameter \#2 \$default of method Illuminate\\Http\\Request\:\:header\(\) expects array\|string\|null, int given\.$#'
			identifier: argument.type
			count: 1
			path: src/Services/TraceService.php
