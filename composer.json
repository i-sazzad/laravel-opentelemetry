{
    "name": "laratel/opentelemetry",
    "description": "A Laravel package for OpenTelemetry tracing, metrics, and logging integration.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "open-telemetry/exporter-otlp": "^1.1",
        "open-telemetry/sdk": "^1.1",
        "open-telemetry/transport-grpc": "^1.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "Laratel\\Opentelemetry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laratel\\Opentelemetry\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laratel\\Opentelemetry\\Providers\\OpenTelemetryServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": ["laravel", "laratel", "opentelemetry", "tracing", "metrics", "logging", "observability", "OTLP", "grpc", "distributed tracing", "monitoring"]
}
